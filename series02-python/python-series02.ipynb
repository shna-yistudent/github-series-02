     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.plot(t, s1, label=\"sinus 1\")\n",
    "plt.plot(t, s2, label=\"sinus 2\")\n",
    "\n",
    "plt.title('sinusoidal function')\n",
    "plt.xlabel('Time (s)')\n",
    "plt.ylabel('Amplitude')\n",
    "\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "\n",
    "plt.savefig('sinusoidal_function.pdf', format='pdf')\n",
    "\n",
    "plt.show()"
   ]
  }
